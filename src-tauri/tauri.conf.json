{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "drophoto",
  "version": "0.4.1",
  "identifier": "com.ahmed.drophoto",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "drophoto",
        "width": 1280,
        "height": 820
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https://tiles.openfreemap.org; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://tiles.openfreemap.org; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/thumbs/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Ahmed ABOUELLEIL SAYED (82S6RGN448)"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVEMkQyNTZCQjI2ODYwOTEKUldTUllHaXlheVV0WFVjbCthR3RFU1Vaem00VlhHVFd1ZytDcktWVVFtd2E1SHR0Nk40Mjd5VnUK",
      "endpoints": [
        "https://github.com/AhmedFr/drophoto/releases/latest/download/latest.json"
      ]
    }
  }
}
